{
  "govnl": {
    "language-switcher": {
      "padding-inline-start": {
        "$type": "spacing",
        "$value": "{govnl.space.2xs}"
      },
      "padding-inline-end": {
        "$type": "spacing",
        "$value": "{govnl.space.2xs}"
      },
      "icon-start": {
        "size": {
          "$type": "dimension",
          "$value": "1.5rem"
        }
      },
      "icon-end": {
        "size": {
          "$type": "dimension",
          "$value": "1.125rem"
        }
      },
      "selectlist": {
        "first-item": {
          "padding-inline-start": {
            "$type": "spacing",
            "$value": "{govnl.space.2xs}"
          },
          "padding-inline-end": {
            "$type": "spacing",
            "$value": "{govnl.space.2xs}"
          },
          "padding-block-start": {
            "$type": "spacing",
            "$value": "0"
          },
          "padding-block-end": {
            "$type": "spacing",
            "$value": "0"
          }
        },
        "item": {
          "icon": {
            "size": {
              "$type": "dimension",
              "$value": "1rem"
            }
          },
          "padding-inline-start": {
            "$type": "spacing",
            "$value": "{govnl.space.xs}"
          },
          "padding-inline-end": {
            "$type": "spacing",
            "$value": "{govnl.space.2xs}"
          },
          "padding-block-start": {
            "$type": "spacing",
            "$value": "{govnl.space.3xs}"
          },
          "padding-block-end": {
            "$type": "spacing",
            "$value": "{govnl.space.3xs}"
          }
        },
        "border-radius": {
          "$type": "borderRadius",
          "$value": "{govnl.border.border-radius.sm}"
        },
        "padding-inline-start": {
          "$type": "spacing",
          "$value": "{govnl.space.3xs}"
        },
        "padding-inline-end": {
          "$type": "spacing",
          "$value": "{govnl.space.3xs}"
        },
        "padding-block-start": {
          "$type": "spacing",
          "$value": "{govnl.space.2xs}"
        },
        "padding-block-end": {
          "$type": "spacing",
          "$value": "{govnl.space.2xs}"
        }
      },
      "select-list": {
        "background-color": {
          "$type": "color",
          "$value": "{govnl.document.background-color}"
        },
        "border-color": {
          "$type": "color",
          "$value": "{govnl.line.subtle.border-color}"
        },
        "item": {
          "label": {
            "$type": "fontSizes",
            "$value": "{govnl.typography.font-size.sm}"
          },
          "color": {
            "$type": "color",
            "$value": "{nl.paragraph.color}"
          }
        },
        "first-item": {
          "color": {
            "$type": "color",
            "$value": "{govnl.document.subtle.color}"
          }
        },
        "hover": {
          "item": {
            "background-color": {
              "$type": "color",
              "$value": "{govnl.form-control.hover.background-color}"
            }
          }
        },
        "focus-visible": {
          "item": {
            "background-color": {
              "$type": "color",
              "$value": "{govnl.focus.background-color}"
            },
            "color": {
              "$type": "color",
              "$value": "{govnl.focus.color}"
            }
          }
        }
      },
      "label": {
        "color": {
          "$type": "color",
          "$value": "{nl.paragraph.color}"
        }
      },
      "hover": {
        "background-color": {
          "$type": "color",
          "$value": "{govnl.form-control.hover.background-color}"
        },
        "border-color": {
          "$type": "color",
          "$value": "{govnl.select.hover.border-color}"
        }
      },
      "active": {
        "background-color": {
          "$type": "color",
          "$value": "{govnl.form-control.hover.background-color}"
        },
        "border-color": {
          "$type": "color",
          "$value": "{govnl.select.hover.border-color}"
        }
      },
      "focus-visible": {
        "background-color": {
          "$type": "color",
          "$value": "{govnl.focus.background-color}"
        }
      }
    }
  }
}