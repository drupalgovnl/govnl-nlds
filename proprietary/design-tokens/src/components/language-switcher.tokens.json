          "$value": "{govnl.space.2xs}"
        },
        "padding-block-end": {
          "$type": "spacing",
          "$value": "{govnl.space.2xs}"
        },
        "background-color": {
          "$type": "color",
          "$value": "{govnl.document.background-color}"
        },
        "border-color": {
          "$type": "color",
          "$value": "{govnl.line.subtle.border-color}"
