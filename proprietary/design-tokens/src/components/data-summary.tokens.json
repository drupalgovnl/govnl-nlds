{
  "govnl": {
    "data-summary": {
      "font-family": {
        "$type": "fontFamilies",
        "$value": "{govnl.document.font-family}"
      },
      "font-size": {
        "$type": "fontSizes",
        "$value": "{govnl.document.font-size}"
      },
      "line-height": {
        "$type": "lineHeights",
        "$value": "{govnl.document.line-height}"
      },
      "content": {
        "row-gap": {
          "$type": "dimension",
          "$value": "{govnl.space.2xs}"
        },
        "item": {
          "column-gap": {
            "$type": "dimension",
            "$value": "{govnl.space.2xs}"
          },
          "key": {
            "flex-basis": {
              "$type": "dimension",
              "$value": "40%"
            }
          },
          "action": {
            "flex-basis": {
              "$type": "dimension",
              "$value": "20%"
            }
          }
        }
      },
      "item": {
        "label": {
          "color": {
            "$type": "color",
            "$value": "{govnl.document.subtle.color}"
          },
          "font-weight": {
            "$type": "fontWeights",
            "$value": "{govnl.document.font-weight}"
          }
        },
        "value": {
          "color": {
            "$type": "color",
            "$value": "{govnl.document.color}"
          },
          "font-weight": {
            "$type": "fontWeights",
            "$value": "{govnl.document.font-weight}"
          }
        }
      },
      "background-color": {
        "$type": "color",
        "$value": "{govnl.surface.subtle.background-color}"
      },
      "border-color": {
        "$type": "color",
        "$value": "{govnl.line.subtle.border-color}"
      },
      "row-gap": {
        "$type": "dimension",
        "$value": "{govnl.space.sm}"
      },
      "head": {
        "title": {
          "column-gap": {
            "$type": "dimension",
            "$value": "{govnl.space.xs}"
          }
        },
        "column-gap": {
          "$type": "dimension",
          "$value": "{govnl.space.2xs}"
        }
      },
      "padding-block-start": {
        "$type": "dimension",
        "$value": "{govnl.space.sm}"
      },
      "padding-inline-start": {
        "$type": "dimension",
        "$value": "{govnl.space.md}"
      },
      "padding-inline-end": {
        "$type": "dimension",
        "$value": "{govnl.space.md}"
      },
      "padding-block-end": {
        "$type": "dimension",
        "$value": "{govnl.space.sm}"
      }
    }
  }
}
